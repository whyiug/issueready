{
  "name": "@issueready/normalize",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic GitHub issue and Issue Form normalization.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whyiug/issueready.git",
    "directory": "packages/normalize"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",

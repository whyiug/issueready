{
  "name": "@issueready/snapshot",
  "version": "0.0.0",
  "private": true,
  "description": "Immutable, digest-bound issue snapshots for IssueReady.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whyiug/issueready.git",
    "directory": "packages/snapshot"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@issueready/domain": "workspace:*",
    "@issueready/normalize": "workspace:*",
    "@issueready/policy": "workspace:*",
    "@issueready/schema": "workspace:*"
  }
}

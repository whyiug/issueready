{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/issueready/locale-bundle/v1alpha1",
  "title": "IssueReady locale bundle",
  "type": "object",
  "required": ["apiVersion", "kind", "locale", "revision", "messages"],
  "properties": {
    "apiVersion": {
      "const": "https://example.invalid/issueready/locale-bundle/v1alpha1"
    },
    "kind": { "const": "LocaleBundle" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" },
    "revision": { "type": "integer", "minimum": 1 },
    "messages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:rules|task-packs)\\.[a-z0-9-]+\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  },
  "additionalProperties": false
}

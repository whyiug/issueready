{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/issueready/rule-manifest/v1alpha1",
  "title": "IssueReady canonical rule manifest",
  "type": "object",
  "required": [
    "id",
    "revision",
    "dimension",
    "engine",
    "messageKey",
    "appliesTo",
    "canonicalLevel",
    "evidenceSources",
    "aggregation",
    "hardPredicate",
    "onFail",
    "onUnknown"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^IR-[A-Z]{3,5}-[0-9]{3}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "dimension": { "type": "string", "minLength": 1 },
    "engine": {
      "enum": ["deterministic", "semantic", "hybrid", "deterministic+semantic"]
    },
    "messageKey": {
      "type": "string",
      "pattern": "^rules\\.[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "generic",
          "bug",
          "feature",
          "docs",
          "dependency",
          "refactor",
          "test-ci",
          "operations"
        ]
      }
    },
    "canonicalLevel": {
      "enum": [
        "mandatory",
        "conditional",
        "advisory",
        "evaluation-only",
        "disposition-only"
      ]
    },
    "evidenceSources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "aggregation": {
      "type": "object",
      "required": [
        "operator",
        "sourcePriority",
        "conflict",
        "unknown",
        "notApplicable",
        "possibleOutcomes"
      ],
      "properties": {
        "operator": { "type": "string", "minLength": 1 },
        "sourcePriority": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "conflict": { "type": "string", "minLength": 1 },
        "unknown": { "type": "string", "minLength": 1 },
        "notApplicable": { "type": "string", "minLength": 1 },
        "possibleOutcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"] }
        }
      },
      "additionalProperties": false
    },
    "hardPredicate": {
      "oneOf": [
        { "const": "none" },
        {
          "type": "object",
          "required": ["kind", "allowedSources"],
          "properties": {
            "kind": {
              "enum": [
                "required-field-provably-empty",
                "title-or-body-provably-empty",
                "independent-goals-with-separate-acceptance",
                "essential-context-provably-unavailable",
                "policy-mapped-disposition",
                "snapshot-invalid-or-incomplete"
              ]
            },
            "allowedSources": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "onFail": {
      "type": "object",
      "required": ["evaluationEffect", "specEffect", "dispositionEffect"],
      "properties": {
        "evaluationEffect": { "enum": ["NONE", "DEGRADED", "ERROR"] },
        "specEffect": { "enum": ["NONE", "NEEDS_INFO", "TOO_BROAD"] },
        "dispositionEffect": {
          "enum": [
            "NONE",
            "CANDIDATE",
            "SUPERVISED",
            "HUMAN_ONLY",
            "UNKNOWN",
            "POLICY_DEFINED"
          ]
        }
      },
      "additionalProperties": false
    },
    "onUnknown": {
      "type": "object",
      "required": ["evaluationEffect", "specEffect", "dispositionEffect"],
      "properties": {
        "evaluationEffect": { "enum": ["NONE", "DEGRADED", "ERROR"] },
        "specEffect": {
          "enum": ["NONE", "NULL_IF_OUTCOME_COULD_CHANGE", "NULL"]
        },
        "dispositionEffect": { "enum": ["NONE", "UNKNOWN"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
